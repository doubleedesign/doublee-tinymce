{
	"name": "doubleedesign/doublee-tinymce",
	"version": "1.0.2",
	"description": "Customised configuration and plugins for WordPress/ClassicPress websites by Double-E Design.",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Leesa Ward",
			"email": "leesa@doubleedesign.com.au"
		}
	],
	"autoload": {
		"classmap": [
			"src/Miniblocks",
			"src/Miniblocks/**"
		],
		"psr-4": {
			"Doubleedesign\\DoubleeTinymce\\": [
				"src/",
				"src/Miniblocks/",
				"src/Miniblocks/ButtonGroup",
				"src/Miniblocks/Callout",
				"src/Miniblocks/Pullquote",
				"src/Tables"
			]
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"ext-dom": "*",
		"ext-libxml": "*"
	}
}
