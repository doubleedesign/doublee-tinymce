{
	"name": "doubleedesign/doublee-tinymce",
	"version": "0.0.1",
	"description": "Customised configuration and plugins for WordPress/ClassicPress websites by Double-E Design.",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Leesa Ward",
			"email": "leesa@doubleedesign.com.au"
		}
	],
	"autoload": {
		"classmap": [
			"src/Miniblocks/",
			"src/Miniblocks/**/",
			"tests/"
		],
		"psr-4": {
			"Doubleedesign\\DoubleeTinymce\\": [
				"src/",
				"src/Miniblocks/",
				"src/Miniblocks/ButtonGroup",
				"src/Miniblocks/Callout",
				"src/Miniblocks/Pullquote",
				"src/Tables"
			],
			"Doubleedesign\\DoubleeTinymce\\Tests\\": [
				"tests/"
			]
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require-dev": {
		"pestphp/pest": "^4.2",
		"brain/monkey": "^2.6",
		"sirbrillig/spies": "^1.10"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
	"require": {
		"ext-dom": "*",
		"ext-libxml": "*"
	}
}
